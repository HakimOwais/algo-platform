# Shared
APP_ENV=development
TIMEZONE=Asia/Kolkata

# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/algo_platform
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
ENABLE_MARKET_SIM=true
ENABLE_PAPER_TRADING=true
DEFAULT_BROKER=paper
SYMBOL_UNIVERSE=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# Risk controls
MAX_DAILY_LOSS_INR=5000
MAX_POSITION_NOTIONAL_INR=100000
MAX_OPEN_ORDERS=20
MAX_ORDER_QTY=1000
ENABLE_MONTE_CARLO_RISK=true
MC_CONFIDENCE=0.95
MC_HORIZON_STEPS=20
MC_PATHS=2000
MAX_MC_VAR_INR=2500
MAX_MC_CVAR_INR=4000
MIN_RISK_HISTORY_BARS=60

# Angel One credentials
# Get these from https://smartapi.angelbroking.com → My Profile → API Management
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# Paper trading with real Angel One market data feed
# Set all four credentials above, then configure symbol tokens below.
# Format: SYMBOL:TOKEN,...  (find tokens via Angel One token search or docs)
# Common NSE tokens (verify at https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json):
#   RELIANCE:2885, TCS:11536, INFY:1594, HDFCBANK:1333, ICICIBANK:4963
#   SBIN:3045, WIPRO:3787, AXISBANK:5900, KOTAKBANK:1922, BAJFINANCE:317
ANGEL_ONE_SYMBOL_TOKENS=RELIANCE:2885,TCS:11536,INFY:1594,HDFCBANK:1333,ICICIBANK:4963

# How often to poll Angel One for prices (seconds). 3 is a safe default (respects rate limits).
ANGEL_ONE_POLL_INTERVAL=3

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
