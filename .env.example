# Shared
APP_ENV=development
TIMEZONE=Asia/Kolkata

# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/algo_platform
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-in-production
ENABLE_MARKET_SIM=true
ENABLE_PAPER_TRADING=true
DEFAULT_BROKER=paper
SYMBOL_UNIVERSE=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# Risk controls
MAX_DAILY_LOSS_INR=5000
MAX_POSITION_NOTIONAL_INR=100000
MAX_OPEN_ORDERS=20
MAX_ORDER_QTY=1000
ENABLE_MONTE_CARLO_RISK=true
MC_CONFIDENCE=0.95
MC_HORIZON_STEPS=20
MC_PATHS=2000
MAX_MC_VAR_INR=2500
MAX_MC_CVAR_INR=4000
MIN_RISK_HISTORY_BARS=60

# Angel One (optional, for live adapter wiring)
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_SECRET=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
